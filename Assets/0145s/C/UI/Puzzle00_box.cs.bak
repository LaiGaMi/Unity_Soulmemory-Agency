using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class Puzzle00_box : MonoBehaviour
{
    [Header("目標Tag")]
    public string targetTag = "tag";


    private RectTransform rect;


    void Start()
    {
        rect =
            GetComponent<RectTransform>();
    }


    void Update()
    {
        CheckTarget();
    }


    //檢查目標物件
    void CheckTarget()
    {
        Puzzle01_car[] cars =
            FindObjectsOfType<Puzzle01_car>();

        foreach(Puzzle01_car car in cars)
        {
            if(car == null)
                continue;


            //確認Tag
            if(!car.gameObject.CompareTag(targetTag))
                continue;


            RectTransform target =
                car.GetComponent<RectTransform>();

            if(target == null)
                continue;


            //確認是否接觸
            if(CheckOverlap(target))
            {
                Destroy(car.gameObject);

                return;
            }
        }
    }


    //檢查是否接觸
    bool CheckOverlap(RectTransform target)
    {
        Rect goalRect =
            GetWorldRect(rect);

        Rect targetRect =
            GetWorldRect(target);


        return goalRect.xMin <= targetRect.xMax &&
               goalRect.xMax >= targetRect.xMin &&
               goalRect.yMin <= targetRect.yMax &&
               goalRect.yMax >= targetRect.yMin;
    }


    //取得世界座標範圍
    Rect GetWorldRect(RectTransform rt)
    {
        Vector3[] corners =
            new Vector3[4];

        rt.GetWorldCorners(corners);


        float x =
            corners[0].x;

        float y =
            corners[0].y;

        float width =
            corners[2].x -
            corners[0].x;

        float height =
            corners[2].y -
            corners[0].y;


        return new Rect(
            x,
            y,
            width,
            height
        );
    }
}
